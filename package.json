{
  "name": "allevamento-cocker-montecorno",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-cms.mjs && node scripts/generate.mjs && vite --host 0.0.0.0",
    "build": "node scripts/prepare-cms.mjs && node scripts/generate.mjs && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:content && playwright test",
    "test:ui": "playwright test --ui",
    "cms:prepare": "node scripts/prepare-cms.mjs",
    "test:content": "node --test checks/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "decap-cms": "3.17.1",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1"
  }
}
